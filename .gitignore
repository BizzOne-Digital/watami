# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ─────────────────────────────────────────────────────
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ── Environment & secrets ────────────────────────────────────────────────────
# All .env files are ignored — commit .env.example only
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Private keys & certificates
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
*.jks
*.keystore

# ── Large binaries & installers ──────────────────────────────────────────────
# These should never be committed — use a CDN or package manager instead
*.msi
*.exe
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage

# ── Media files (large) ──────────────────────────────────────────────────────
# Audio/video should be hosted on a CDN, not in the repo
*.mp3
*.mp4
*.mpeg
*.mov
*.avi
*.wav
*.ogg
*.flac
*.webm

# ── Temporary & OS files ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/coverage
*.log

# ── Vercel ───────────────────────────────────────────────────────────────────
.vercel
